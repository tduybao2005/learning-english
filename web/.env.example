DATABASE_URL="postgresql://user:password@localhost:5432/learning_english"
DIRECT_URL="postgresql://user:password@localhost:5432/learning_english"
SESSION_SECRET="<openssl rand -hex 32>"
RESEND_API_KEY="re_..."
OTP_EMAIL_FROM="Learning English <no-reply@your-domain.example>"
# Set to "false" if serving over plain HTTP to something other than
# localhost (e.g. a LAN IP) — otherwise the browser drops the session cookie.
SESSION_COOKIE_SECURE="true"
