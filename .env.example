# Env vars for docker-compose.yml (repo root). Copy to `.env`: `make env`
# (this generates a random AUTH_SECRET for you).
#
# Not to be confused with web/.env.example, which is for running the app
# directly on the host (npm run dev) against your own Postgres — see
# web/README.md for that path.

POSTGRES_USER=learning_english
POSTGRES_PASSWORD=learning_english
POSTGRES_DB=learning_english
POSTGRES_PORT=5432
WEB_PORT=3000

# NextAuth (Auth.js) — Google OAuth login.
# AUTH_SECRET: openssl rand -hex 32 (may reuse the old SESSION_SECRET value)
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: Google Cloud Console → APIs & Services
#   → Credentials → OAuth 2.0 Client ID (Web application). Authorized redirect
#   URI: <AUTH_URL>/api/auth/callback/google
# AUTH_URL: public origin of the app (http://localhost:3000 locally,
#   https://<your-tunnel-domain> behind the Cloudflare tunnel)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# cloudflare config
TUNNEL_TOKEN=get-it-from-cloudflare-zerotrust-tunnel-networks

# Optional sign-in allowlist — restricts Google OAuth login to these emails
# (comma-separated). Leave blank/unset for unrestricted login (default,
# used everywhere except a host meant to be single-learner-only).
ALLOWED_EMAILS=
