# Env vars for docker-compose.yml (repo root). Copy to `.env`: `make env`
# (this generates a random SESSION_SECRET for you).
#
# Not to be confused with web/.env.example, which is for running the app
# directly on the host (npm run dev) against your own Postgres — see
# web/README.md for that path.

POSTGRES_USER=learning_english
POSTGRES_PASSWORD=learning_english
POSTGRES_DB=learning_english
POSTGRES_PORT=5432
WEB_PORT=3000

# Generated automatically by `make env`; only needed here if you're writing
# this file by hand instead.
SESSION_SECRET=

# Left blank: OTP codes print to `make logs` instead of being emailed.
# Fill in once you have a real Resend account and set OTP_DEV_ECHO=false.
RESEND_API_KEY=
OTP_DEV_ECHO=true

# Defaults to false: this stack serves plain HTTP, and browsers silently
# drop `Secure` cookies on plain-HTTP origins other than localhost — that
# breaks login for anyone hitting it over LAN (e.g. http://192.168.x.x:3000).
# Set to true only once this is served over HTTPS (e.g. behind a TLS proxy).
SESSION_COOKIE_SECURE=false

# cloudflare config
TUNNEL_TOKEN=get-it-from-cloudflare-zerotrust-tunnel-networks
