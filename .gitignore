/.quarto/
/.worktrees/
__pycache__/

# docker-compose env (generated by `make env`; see .env.example)
/.env
# test-stack env (generated by `make test-env`; see .env.test.example)
/.env.test

# Local tooling, editor state and working notes: useful on this machine,
# not part of the project anyone else checks out.
.claude/
.superpowers/
.design-sync/
.ds-sync/
.playwright-mcp/
.idea/
.vscode/
/ds-bundle/
/web/.ds-css/
docs/agent-guide.md
docs/design/
docs/superpowers/
docs/plans/
docs/WORKFLOW.md

# Database dumps and environment backups: these carry real credentials and
# real user rows, and neither belongs in a repository.
backups/
*.sql.gz
*.dump
# Root-level only: Prisma migrations are .sql too and must stay tracked.
/*.sql
.env.bak*
.env.*.bak

# Scratch files that keep landing in the working tree
Pasted image*.png
*.wip
